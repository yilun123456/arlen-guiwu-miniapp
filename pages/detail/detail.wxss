.detail-page {
  padding-bottom: calc(70rpx + env(safe-area-inset-bottom));
}

.identity {
  display: flex;
  align-items: center;
  margin: 4rpx 2rpx 28rpx;
}

.identity__icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin-right: 22rpx;
  font-size: 52rpx;
  border-radius: 30rpx;
}

.identity__copy {
  min-width: 0;
  flex: 1;
}

.identity__name {
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity__meta {
  margin-top: 10rpx;
  color: #929baa;
  font-size: 21rpx;
}

.identity__edit {
  padding: 13rpx 20rpx;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 650;
  background: #eaf3ff;
  border-radius: 999rpx;
}

.billing-hero {
  position: relative;
  box-sizing: border-box;
  min-height: 390rpx;
  padding: 30rpx;
  overflow: hidden;
  color: #ffffff;
  text-align: center;
  background: linear-gradient(145deg, #258fff 0%, #116adf 58%, #0754c7 100%);
  border-radius: 34rpx;
  box-shadow: 0 20rpx 46rpx rgba(16, 100, 220, 0.27);
}

.billing-hero__glow {
  position: absolute;
  top: -230rpx;
  left: 50%;
  width: 620rpx;
  height: 420rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  transform: translateX(-50%);
}

.billing-hero__top,
.billing-hero__label,
.billing-hero__price,
.billing-hero__desc,
.hero-progress,
.hero-progress__copy {
  position: relative;
  z-index: 1;
}

.billing-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.billing-status,
.billing-days {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  color: rgba(255, 255, 255, 0.83);
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
}

.billing-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 9rpx;
  background: #65f0bd;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(101, 240, 189, 0.14);
}

.billing-dot--paused {
  background: #ffd081;
  box-shadow: 0 0 0 6rpx rgba(255, 208, 129, 0.14);
}

.billing-dot--using {
  background: #65f0bd;
  box-shadow: 0 0 0 6rpx rgba(101, 240, 189, 0.14);
}

.billing-dot--collected {
  background: #c5aaff;
  box-shadow: 0 0 0 6rpx rgba(197, 170, 255, 0.14);
}

.billing-dot--retired {
  background: #c4cad3;
  box-shadow: 0 0 0 6rpx rgba(196, 202, 211, 0.14);
}

.billing-hero__label {
  margin-top: 43rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.billing-hero__price {
  margin-top: 8rpx;
  font-size: 68rpx;
  font-weight: 850;
  letter-spacing: -2rpx;
}

.billing-hero__price text {
  margin-right: 7rpx;
  font-size: 30rpx;
}

.billing-hero__desc {
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.daily-compare {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 34rpx;
}

.daily-compare view {
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
}

.daily-compare text,
.daily-compare__strong {
  display: block;
}

.daily-compare text {
  color: rgba(255, 255, 255, 0.56);
  font-size: 18rpx;
}

.daily-compare__strong {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-progress {
  height: 10rpx;
  margin-top: 38rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.hero-progress__fill {
  height: 100%;
  background: #ffffff;
  border-radius: 999rpx;
}

.hero-progress__copy {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 19rpx;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.use-button,
.pause-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 24rpx;
}

.use-button {
  color: #ffffff;
  background: #17263f;
  box-shadow: 0 10rpx 24rpx rgba(23, 38, 63, 0.16);
}

.use-button__plus {
  margin-right: 9rpx;
  font-size: 35rpx;
  font-weight: 400;
}

.pause-button {
  color: #596477;
  background: #ffffff;
  border: 1rpx solid #e6e9ef;
}

.pause-button text {
  margin-right: 10rpx;
  color: #1677ff;
  font-size: 22rpx;
}

.detail-section-title {
  margin: 42rpx 4rpx 18rpx;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metric-card {
  box-sizing: border-box;
  min-height: 190rpx;
  padding: 24rpx;
}

.metric-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 24rpx;
  font-weight: 750;
  border-radius: 15rpx;
}

.metric-card__icon--blue { color: #1677ff; background: #eaf3ff; }
.metric-card__icon--green { color: #16a276; background: #e8f8f2; }
.metric-card__icon--purple { color: #785ce9; background: #f0edff; }
.metric-card__icon--orange { color: #e78b24; background: #fff3e3; }

.metric-card__label {
  margin-top: 18rpx;
  color: #8e98a7;
  font-size: 21rpx;
}

.metric-card__value {
  margin-top: 7rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.info-card {
  padding: 0 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row__label {
  color: #6f798b;
  font-size: 23rpx;
}

.info-row__value {
  margin-left: 20rpx;
  color: #2b3549;
  font-size: 23rpx;
  font-weight: 650;
}

.info-row__value--blue {
  color: #1677ff;
}

.info-row--formula {
  min-height: 116rpx;
}

.formula {
  margin-top: 6rpx;
  color: #a0a8b4;
  font-size: 18rpx;
}

.note-card {
  padding: 26rpx 28rpx;
  color: #5f6a7c;
  font-size: 24rpx;
  line-height: 1.7;
}

.delete-button {
  height: 82rpx;
  margin-top: 50rpx;
  color: #e55764;
  font-size: 24rpx;
  background: #fff0f1;
  border-radius: 22rpx;
}
