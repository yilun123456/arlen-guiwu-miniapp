.stats-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.stats-title {
  margin: 6rpx 4rpx 0;
  font-size: 44rpx;
  font-weight: 800;
}

.stats-subtitle {
  margin: 9rpx 4rpx 28rpx;
  color: #8f98a8;
  font-size: 23rpx;
}

.overview-card {
  position: relative;
  box-sizing: border-box;
  height: 340rpx;
  padding: 34rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(140deg, #223d78 0%, #172c5b 52%, #111f41 100%);
  border-radius: 34rpx;
  box-shadow: 0 20rpx 42rpx rgba(23, 43, 85, 0.25);
}

.overview-card__orb {
  position: absolute;
  top: -150rpx;
  right: -90rpx;
  width: 390rpx;
  height: 390rpx;
  background: radial-gradient(circle, rgba(74, 139, 255, 0.55), rgba(74, 139, 255, 0));
}

.overview-label,
.overview-value,
.overview-grid {
  position: relative;
  z-index: 1;
}

.overview-label {
  color: rgba(255, 255, 255, 0.63);
  font-size: 23rpx;
}

.overview-value {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 800;
}

.overview-value text {
  margin-right: 7rpx;
  font-size: 29rpx;
}

.overview-grid {
  display: flex;
  align-items: center;
  margin-top: 38rpx;
  padding-top: 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.overview-metric {
  flex: 1;
}

.overview-metric__label {
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
}

.overview-metric__value {
  margin-top: 7rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.overview-divider {
  width: 1rpx;
  height: 50rpx;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.14);
}

.projection-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.projection-card {
  display: flex;
  align-items: center;
  padding: 23rpx;
}

.projection-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 15rpx;
  font-size: 22rpx;
  font-weight: 750;
  border-radius: 19rpx;
}

.projection-icon--blue { color: #1677ff; background: #eaf3ff; }
.projection-icon--purple { color: #7358e8; background: #f0edff; }

.projection-copy {
  min-width: 0;
}

.projection-label {
  color: #939cab;
  font-size: 19rpx;
}

.projection-value {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 25rpx 18rpx;
}

.status-strip__item {
  display: flex;
  align-items: center;
  color: #858f9f;
  font-size: 20rpx;
}

.status-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.status-dot--active { background: #16b47f; }
.status-dot--paused { background: #f1a13f; }

.status-number {
  margin-left: 8rpx;
  color: #273248;
  font-weight: 750;
}

.status-strip__line {
  width: 1rpx;
  height: 32rpx;
  background: #e9ecf1;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 3rpx 18rpx;
}

.section-note {
  color: #9aa3b1;
  font-size: 21rpx;
}

.chart-card,
.ranking-card {
  padding: 6rpx 26rpx;
}

.category-stat {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eff1f5;
}

.category-stat:last-child,
.ranking-row:last-child {
  border-bottom: 0;
}

.category-stat__head,
.category-stat__identity {
  display: flex;
  align-items: center;
}

.category-stat__head {
  justify-content: space-between;
}

.category-stat__emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 15rpx;
  font-size: 31rpx;
  border-radius: 19rpx;
}

.category-stat__name {
  font-size: 24rpx;
  font-weight: 700;
}

.category-stat__count {
  margin-top: 5rpx;
  color: #9aa3b1;
  font-size: 18rpx;
}

.category-stat__amount {
  font-size: 24rpx;
  font-weight: 750;
}

.bar-track {
  height: 9rpx;
  margin-top: 18rpx;
  overflow: hidden;
  background: #edf0f4;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.ranking-row {
  display: flex;
  align-items: center;
  padding: 23rpx 0;
  border-bottom: 1rpx solid #eff1f5;
}

.rank-number {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 13rpx;
  color: #9ca5b2;
  font-size: 20rpx;
  font-weight: 700;
}

.rank-number--top {
  color: #1677ff;
  background: #eaf3ff;
  border-radius: 11rpx;
}

.rank-emoji {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 15rpx;
  font-size: 30rpx;
  border-radius: 19rpx;
}

.rank-main {
  min-width: 0;
  flex: 1;
}

.rank-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-name {
  max-width: 270rpx;
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-cost {
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 650;
}

.rank-track {
  height: 7rpx;
  margin-top: 12rpx;
  overflow: hidden;
  background: #edf0f4;
  border-radius: 999rpx;
}

.rank-fill {
  height: 100%;
  background: linear-gradient(90deg, #55abff, #1677ff);
  border-radius: 999rpx;
}

.formula-tip {
  display: flex;
  margin-top: 26rpx;
  padding: 24rpx;
  background: #edf5ff;
  border-radius: 24rpx;
}

.formula-tip__icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 15rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 750;
  background: #1677ff;
  border-radius: 50%;
}

.formula-tip__title {
  color: #2367bd;
  font-size: 22rpx;
  font-weight: 700;
}

.formula-tip__desc {
  margin-top: 7rpx;
  color: #6b8bb3;
  font-size: 19rpx;
  line-height: 1.65;
}

.empty-state {
  margin-top: 45rpx;
  padding: 70rpx 42rpx;
  text-align: center;
}

.empty-chart {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 122rpx;
  height: 122rpx;
  margin: 0 auto 25rpx;
  color: #579cf1;
  font-size: 62rpx;
  background: #eaf4ff;
  border-radius: 34rpx;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 750;
}

.empty-desc {
  margin: 14rpx auto 28rpx;
  color: #929baa;
  font-size: 22rpx;
  line-height: 1.7;
}

.empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 30rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 650;
  background: #edf5ff;
  border-radius: 22rpx;
}
