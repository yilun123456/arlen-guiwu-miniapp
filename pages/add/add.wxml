<view class="page-shell add-page">
  <view class="intro">
    <view class="intro__title">{{editMode ? '更新物品信息' : '记下你的新物品'}}</view>
    <view class="intro__desc">无需预估寿命，只用价格和日期计算实际日均成本</view>
  </view>

  <view class="form-card card">
    <view class="field">
      <view class="field__label"><text class="required">*</text>物品名称</view>
      <input class="field__input" value="{{form.name}}" maxlength="24" placeholder="例如：通勤耳机" placeholder-class="field__placeholder" data-field="name" bindinput="onFieldInput" />
    </view>

    <view class="field field--last">
      <view class="field__label"><text class="required">*</text>物品分类</view>
      <view class="category-grid">
        <view wx:for="{{categories}}" wx:key="id" class="category-option {{form.category === item.id ? 'category-option--active' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory">
          <view class="category-option__emoji">{{item.emoji}}</view>
          <view class="category-option__name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="form-card card">
    <view class="field">
      <view class="field__label"><text class="required">*</text>购入价格</view>
      <view class="money-input">
        <text class="money-input__symbol">¥</text>
        <input class="field__input money-input__control" value="{{form.price}}" type="digit" placeholder="0.00" placeholder-class="field__placeholder" data-field="price" bindinput="onFieldInput" />
      </view>
    </view>

    <view class="field">
      <view class="field__label"><text class="required">*</text>购入日期</view>
      <picker mode="date" value="{{form.purchaseDate}}" end="{{today}}" bindchange="onDateChange">
        <view class="picker-value"><text>{{form.purchaseDate}}</text><text class="picker-arrow">›</text></view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">当前状态</view>
      <view class="field__hint">已退役的物品会停在退役当天，不再增加持有天数</view>
      <view class="status-options">
        <view wx:for="{{statuses}}" wx:key="id" class="status-option status-option--{{item.id}} {{form.itemStatus === item.id ? 'status-option--active' : ''}}" data-id="{{item.id}}" bindtap="chooseStatus">
          <view class="status-option__dot"></view>{{item.name}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">购买渠道</view>
      <input class="field__input" value="{{form.channel}}" maxlength="30" placeholder="例如：京东、自营店、朋友赠送" placeholder-class="field__placeholder" data-field="channel" bindinput="onFieldInput" />
    </view>

    <view class="field">
      <view class="field__label">已有使用次数</view>
      <view class="field__hint">用于计算单次使用成本，之后可在详情页继续打卡</view>
      <input class="field__input" value="{{form.useCount}}" type="number" placeholder="0" placeholder-class="field__placeholder" data-field="useCount" bindinput="onFieldInput" />
    </view>

    <view class="field field--last">
      <view class="field__label">备注</view>
      <textarea class="note-input" value="{{form.note}}" maxlength="120" auto-height="{{true}}" placeholder="保修时间、型号或想记住的事" placeholder-class="field__placeholder" data-field="note" bindinput="onFieldInput"></textarea>
      <view class="char-count">{{form.note.length}} / 120</view>
    </view>
  </view>

  <view wx:if="{{preview}}" class="preview-card">
    <view class="preview-card__head">
      <view>
        <view class="preview-card__label">实时预览</view>
        <view class="preview-card__title">当前平均每天成本</view>
      </view>
      <view class="preview-card__price"><text>¥</text>{{preview.dailyCostText}}</view>
    </view>
    <view class="preview-card__rule">¥{{preview.priceText}} ÷ {{preview.ownershipDays}} 天 = ¥{{preview.dailyCostText}}/天</view>
    <view class="preview-card__compare">
      <view><text>当前持有</text><text class="preview-card__strong">{{preview.ownershipDays}} 天</text></view>
      <view><text>明天日均</text><text class="preview-card__strong">¥{{preview.tomorrowDailyCostText}}</text></view>
    </view>
  </view>

  <button class="primary-button submit-button" bindtap="submit">{{editMode ? '保存修改' : '添加并开始计算'}}</button>
  <view class="privacy-tip">所有数据仅保存在你的微信本地存储中</view>
</view>
