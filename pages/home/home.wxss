.home-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.top-copy,
.asset-card__head,
.asset-card__metrics,
.search-row,
.list-heading,
.item-card,
.item-name-row {
  display: flex;
  align-items: center;
}

.top-copy {
  justify-content: space-between;
  margin: 4rpx 4rpx 24rpx;
}

.eyebrow {
  color: #8b95a7;
  font-size: 23rpx;
}

.greeting {
  margin-top: 5rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.add-button {
  height: 72rpx;
  padding: 0 25rpx;
  color: #1677ff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
  background: #eaf3ff;
  border-radius: 999rpx;
}

.asset-card {
  position: relative;
  box-sizing: border-box;
  min-height: 310rpx;
  padding: 32rpx 34rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(135deg, #287ef4 0%, #3c9bf4 100%);
  border-radius: 38rpx;
  box-shadow: 0 22rpx 48rpx rgba(28, 119, 231, 0.25);
}

.asset-card__glow {
  position: absolute;
  background: rgba(255, 255, 255, 0.11);
  border-radius: 50%;
}

.asset-card__glow--one {
  top: -140rpx;
  right: -80rpx;
  width: 330rpx;
  height: 330rpx;
}

.asset-card__glow--two {
  bottom: -220rpx;
  left: 150rpx;
  width: 390rpx;
  height: 390rpx;
}

.asset-card__head,
.asset-card__metrics,
.asset-card__foot {
  position: relative;
  z-index: 1;
}

.asset-card__head {
  justify-content: space-between;
}

.asset-card__title {
  font-size: 26rpx;
  font-weight: 750;
}

.count-chip {
  padding: 10rpx 16rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}

.asset-card__metrics {
  margin-top: 38rpx;
}

.hero-metric {
  flex: 1;
}

.hero-metric--right {
  padding-left: 30rpx;
}

.hero-metric__label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.hero-metric__value {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.hero-metric__value text {
  margin-right: 6rpx;
  font-size: 25rpx;
}

.metric-line {
  width: 1rpx;
  height: 78rpx;
  background: rgba(255, 255, 255, 0.26);
}

.asset-card__foot {
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 20rpx;
}

.status-scroll,
.category-scroll {
  width: calc(100vw - 28rpx);
  white-space: nowrap;
}

.status-scroll {
  margin-top: 24rpx;
}

.status-row,
.category-row {
  display: inline-flex;
  padding-right: 28rpx;
}

.status-chip,
.category-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 13rpx;
  color: #6e788a;
  background: #ffffff;
  border: 1rpx solid #e7eaf0;
  border-radius: 999rpx;
}

.status-chip {
  padding: 17rpx 25rpx;
  font-size: 24rpx;
}

.status-chip text {
  margin-left: 8rpx;
  color: #a5adba;
  font-size: 19rpx;
}

.status-chip--active {
  color: #ffffff;
  font-weight: 700;
  background: #1677ff;
  border-color: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.18);
}

.status-chip--active text {
  color: rgba(255, 255, 255, 0.75);
}

.search-row {
  margin-top: 24rpx;
}

.search-box {
  display: flex;
  flex: 1;
  align-items: center;
  height: 82rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(30, 47, 80, 0.06);
  border-radius: 25rpx;
}

.search-icon {
  margin-right: 13rpx;
  color: #768196;
  font-size: 34rpx;
  transform: rotate(-18deg);
}

.search-input {
  flex: 1;
  height: 82rpx;
  font-size: 25rpx;
}

.search-placeholder {
  color: #b1b8c4;
}

.clear-search {
  width: 38rpx;
  height: 38rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
  background: #c6ccd5;
  border-radius: 50%;
}

.stats-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-left: 14rpx;
  color: #725be3;
  font-size: 34rpx;
  background: #f0edff;
  border-radius: 25rpx;
}

.category-scroll {
  margin-top: 18rpx;
}

.category-chip {
  padding: 13rpx 19rpx;
  font-size: 21rpx;
}

.category-chip--active {
  color: #1677ff;
  font-weight: 700;
  background: #eaf3ff;
  border-color: #d4e7ff;
}

.category-chip__emoji {
  margin-right: 7rpx;
}

.list-heading {
  justify-content: space-between;
  margin: 36rpx 2rpx 18rpx;
}

.list-count {
  margin-left: 6rpx;
  color: #9ba4b2;
  font-size: 21rpx;
}

.list-tip {
  margin-top: 6rpx;
  color: #a0a8b5;
  font-size: 18rpx;
}

.sort-button {
  padding: 12rpx 17rpx;
  color: #687387;
  font-size: 20rpx;
  background: #ffffff;
  border-radius: 15rpx;
}

.sort-arrow {
  margin-left: 5rpx;
  color: #1677ff;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.item-card {
  box-sizing: border-box;
  min-height: 154rpx;
  padding: 23rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(30, 47, 80, 0.05);
  border-left: 7rpx solid #23aa79;
  border-radius: 27rpx;
  box-shadow: 0 10rpx 30rpx rgba(55, 82, 126, 0.07);
}

.item-card--collected {
  border-left-color: #8d6be8;
}

.item-card--retired {
  opacity: 0.76;
  border-left-color: #9ca5b2;
}

.item-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  font-size: 37rpx;
  border-radius: 22rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name-row {
  min-width: 0;
}

.item-name {
  max-width: 270rpx;
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex: none;
  margin-left: 10rpx;
  padding: 5rpx 10rpx;
  color: #188b64;
  font-size: 16rpx;
  background: #e8f7f1;
  border-radius: 999rpx;
}

.status-badge--collected {
  color: #7356cf;
  background: #f0edff;
}

.status-badge--retired {
  color: #778193;
  background: #eef0f3;
}

.item-meta {
  margin-top: 7rpx;
  color: #7f8999;
  font-size: 22rpx;
}

.item-meta text {
  color: #198967;
  font-weight: 650;
}

.item-channel {
  margin-top: 5rpx;
  overflow: hidden;
  color: #adb4bf;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-number {
  display: flex;
  flex: none;
  align-items: baseline;
  margin-left: 16rpx;
  color: #263247;
}

.day-number view {
  font-size: 44rpx;
  font-weight: 800;
}

.day-number text {
  margin-left: 5rpx;
  color: #8b95a5;
  font-size: 22rpx;
}

.empty-state {
  margin-top: 12rpx;
  padding: 64rpx 38rpx;
  text-align: center;
}

.empty-illustration {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 24rpx;
  color: #509af1;
  font-size: 68rpx;
  line-height: 104rpx;
  background: #eaf4ff;
  border-radius: 31rpx;
}

.empty-illustration text {
  position: absolute;
  top: -16rpx;
  right: -10rpx;
  font-size: 30rpx;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 750;
}

.empty-desc {
  margin: 13rpx auto 27rpx;
  color: #929baa;
  font-size: 22rpx;
  line-height: 1.7;
}

.empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 30rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 650;
  background: #edf5ff;
  border-radius: 22rpx;
}
