.home-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.top-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 4rpx 26rpx;
}

.eyebrow {
  color: #8b95a7;
  font-size: 24rpx;
}

.greeting {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 800;
  background: #eaf3ff;
  border-radius: 24rpx;
}

.asset-card {
  position: relative;
  box-sizing: border-box;
  height: 356rpx;
  padding: 36rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(135deg, #2495ff 0%, #0d65ed 56%, #0754cf 100%);
  border-radius: 36rpx;
  box-shadow: 0 24rpx 50rpx rgba(18, 103, 229, 0.28);
}

.asset-card__glow {
  position: absolute;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.asset-card__glow--one {
  top: -160rpx;
  right: -100rpx;
  width: 380rpx;
  height: 380rpx;
}

.asset-card__glow--two {
  right: 230rpx;
  bottom: -260rpx;
  width: 430rpx;
  height: 430rpx;
}

.asset-card__head,
.asset-card__metrics,
.asset-card__foot {
  position: relative;
  z-index: 1;
}

.asset-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.asset-card__label,
.hero-metric__label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.asset-card__value {
  margin-top: 12rpx;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.currency {
  margin-right: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.count-chip {
  padding: 11rpx 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.17);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.asset-card__metrics {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.hero-metric {
  width: 44%;
}

.hero-metric__value {
  margin-top: 9rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.metric-line {
  width: 1rpx;
  height: 56rpx;
  margin-right: 34rpx;
  background: rgba(255, 255, 255, 0.2);
}

.asset-card__foot {
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 21rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.quick-action {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  padding: 22rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(30, 47, 80, 0.05);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(55, 82, 126, 0.06);
}

.quick-action__icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  font-size: 35rpx;
  font-weight: 400;
  border-radius: 22rpx;
}

.quick-action__icon--blue {
  color: #1677ff;
  background: #eaf3ff;
}

.quick-action__icon--purple {
  color: #7358e8;
  background: #f0edff;
}

.quick-action__title {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action__desc {
  margin-top: 7rpx;
  overflow: hidden;
  color: #99a2b1;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(30, 47, 80, 0.06);
  border-radius: 26rpx;
}

.search-icon {
  margin-right: 15rpx;
  color: #768196;
  font-size: 38rpx;
  transform: rotate(-18deg);
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 27rpx;
}

.search-placeholder {
  color: #b1b8c4;
}

.clear-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  font-size: 30rpx;
  background: #c6ccd5;
  border-radius: 50%;
}

.category-scroll {
  width: calc(100vw - 28rpx);
  margin-top: 24rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  padding-right: 28rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 14rpx;
  padding: 17rpx 24rpx;
  color: #6e788a;
  font-size: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e8ebf1;
  border-radius: 999rpx;
}

.category-chip--active {
  color: #ffffff;
  font-weight: 650;
  background: #1677ff;
  border-color: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.2);
}

.category-chip__emoji {
  margin-right: 8rpx;
  font-size: 23rpx;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 2rpx 20rpx;
}

.list-count {
  margin-left: 8rpx;
  color: #a1a9b7;
  font-size: 23rpx;
  font-weight: 500;
}

.sort-button {
  padding: 10rpx 16rpx;
  color: #6d7789;
  font-size: 22rpx;
  background: #eef1f6;
  border-radius: 999rpx;
}

.sort-arrow {
  margin-left: 5rpx;
  color: #1677ff;
}

.item-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.item-card__top {
  display: flex;
  align-items: center;
}

.item-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-right: 20rpx;
  font-size: 42rpx;
  border-radius: 27rpx;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-name-row {
  display: flex;
  align-items: center;
}

.item-name {
  max-width: 280rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: none;
  margin-left: 12rpx;
  padding: 5rpx 10rpx;
  color: #17a673;
  font-size: 18rpx;
  background: #e9f9f2;
  border-radius: 999rpx;
}

.status--paused {
  color: #9b6a24;
  background: #fff5e4;
}

.item-meta {
  margin-top: 10rpx;
  color: #969fad;
  font-size: 21rpx;
}

.chevron {
  margin-left: 12rpx;
  color: #bdc3cd;
  font-size: 40rpx;
}

.item-numbers {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f2f6;
}

.item-number {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.item-number--right {
  align-items: flex-end;
}

.item-number__label {
  color: #939dac;
  font-size: 21rpx;
}

.item-number__value {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.item-number__value--blue {
  color: #1677ff;
}

.progress-track {
  height: 9rpx;
  margin-top: 25rpx;
  overflow: hidden;
  background: #ecf0f5;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3ca0ff, #176fe5);
  border-radius: 999rpx;
}

.progress-copy {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #a0a8b5;
  font-size: 19rpx;
}

.empty-state {
  padding: 62rpx 40rpx 54rpx;
  text-align: center;
}

.empty-illustration {
  position: relative;
  width: 150rpx;
  height: 122rpx;
  margin: 0 auto 24rpx;
}

.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 100rpx;
  margin: auto;
  color: #5a9ff5;
  font-size: 74rpx;
  background: #eaf4ff;
  border-radius: 28rpx;
  transform: rotate(-4deg);
}

.empty-spark {
  position: absolute;
  color: #88bdff;
}

.empty-spark--one {
  top: -10rpx;
  right: 0;
  font-size: 30rpx;
}

.empty-spark--two {
  bottom: 6rpx;
  left: 0;
  font-size: 45rpx;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 750;
}

.empty-desc {
  max-width: 500rpx;
  margin: 14rpx auto 28rpx;
  color: #929baa;
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 30rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 650;
  background: #edf5ff;
  border-radius: 22rpx;
}
